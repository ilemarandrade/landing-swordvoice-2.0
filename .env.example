# URL base de la API de SwordVoice
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Client IDs públicos de OAuth: el mismo valor que GOOGLE_CLIENT_ID, GITHUB_CLIENT_ID
# y LINKEDIN_CLIENT_ID de la API. El client secret NUNCA va aquí. Sin valor, el botón
# de ese proveedor no se muestra. Se incrustan en el build: defínelos también en el
# entorno de build de Cloudflare.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
