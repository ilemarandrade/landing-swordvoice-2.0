    "@types/react-dom": "^19.3.0",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^4.2.2",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "prettier": "3.1.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.150.0"
