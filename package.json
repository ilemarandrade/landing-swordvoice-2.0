{
  "name": "swordvoice-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
