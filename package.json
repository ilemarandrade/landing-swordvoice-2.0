    "@opennextjs/cloudflare": "^1.20.11",
    "@tanstack/react-query": "^5.104.2",
    "framer-motion": "^11.18.2",
    "next": "15.5.27",
    "nodemailer": "^6.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.49.3",
    "react-hot-toast": "^2.4.1",
    "react-slick": "^0.31.0",
    "server-only": "^0.0.1",
    "slick-carousel": "^1.8.1",
    "yup": "^1.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
